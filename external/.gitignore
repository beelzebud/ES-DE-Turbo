lunasvg/**/*Config.cmake
lunasvg/**/*ConfigVersion.cmake
lunasvg/**/*Targets.cmake
lunasvg/**/*.pc
lunasvg/**/Makefile
lunasvg/*.sln
lunasvg/*.vcxproj
lunasvg/*.vcxproj.filters

rlottie/**/CMakeFiles/
rlottie/**/cmake_install.cmake
rlottie/**/*Config.cmake
rlottie/**/*ConfigVersion.cmake
rlottie/**/*Targets.cmake
rlottie/**/*.pc
rlottie/config.h
rlottie/**/Makefile
rlottie/*.sln
rlottie/*.vcxproj
rlottie/*.vcxproj.filters
rlottie/**/*.expmap

# Compiled binaries (prebuilt demos and in-tree build output).
**/*.obj
**/*.dll
**/*.exe
**/*.lib
**/*.a
**/*.so
**/*.dylib
**/*.pdb
**/*.exp
